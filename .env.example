# This file is committed. Never put real values here.
# Usage: cp .env.example .env  ->  fill in .env (never commit .env)

# BAZE API Gateway (Claude Opus 5)
KU_LLM_API_KEY=
KU_LLM_BASE_URL=https://api.baze.co/v1/gateway/claude
KU_LLM_MODEL=claude-opus-5

# Own staging target. Leave empty until the staging target container exists.
STAGING_TARGET_URL=

# Canary of our own staging target (the "canary" value in staging_target/secrets/vulns.json).
# Used only by the Verifier's code check. Leave empty to turn that check off.
STAGING_TARGET_CANARY=

# Session log (JSONL, hash-chained). One file = one session. Relative paths resolve from the working directory.
LOG_PATH=logs/session.jsonl
