# Files read by bash, Squid or Docker inside Linux must keep LF line endings,
# even when checked out on Windows (core.autocrlf=true would turn them into CRLF).
*.sh        text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Pinned data (sha256-checked on load, CLAUDE.md §7): never convert line endings.
data/** -text
